{
  "name": "wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "start:api": "APP_ROLE=api bun src/main.ts",
    "start:worker": "APP_ROLE=worker bun src/main.ts",
    "migrate:up": "bun src/cli/migrate.ts up",
    "migrate:down": "bun src/cli/migrate.ts down",
    "queues:setup": "bun src/cli/setup-queues.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "infra:up": "docker compose up -d --wait postgres sqs",
    "infra:down": "docker compose down -v",
    "test": "bun test --timeout 120000",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 120000 test/integration",
    "test:concurrency": "bun test --timeout 180000 test/concurrency",
    "test:load": "bun test/load/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1163.0",
    "@mikro-orm/core": "^7.2.7",
    "@mikro-orm/migrations": "^7.2.7",
    "@mikro-orm/postgresql": "^7.2.7",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "decimal.js": "^10.6.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "typescript": "5"
  }
}
