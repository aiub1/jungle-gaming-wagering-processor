# Copie para .env para rodar a aplicação fora do Docker
# APP_ROLE: api | worker | all
APP_ROLE=all
PORT=3000
DATABASE_URL=postgresql://wagering:wagering@localhost:55432/wagering
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_COMMANDS_QUEUE=wager-transactions.fifo
SQS_COMMANDS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wagering-events.fifo
LOG_LEVEL=info
